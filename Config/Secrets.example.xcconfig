// Copy to Config/Secrets.xcconfig (git-ignored) and fill in. Then run `xcodegen generate`.

// Google Cloud Console -> Credentials -> OAuth client ID -> iOS, bundle ID com.robertlangat.thingstodonext
GOOGLE_IOS_CLIENT_ID = 1234567890-abc123.apps.googleusercontent.com
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234567890-abc123

// AI planner backend (the same backend/ service as the Android repo). Note the $() trick for "//".
AI_BACKEND_URL = https:/$()/planner.example.com
// Optional shared token if the backend sets APP_SHARED_TOKEN (not a provider key).
AI_APP_TOKEN =

// Your Apple Developer team ID for signing on a device / TestFlight.
DEVELOPMENT_TEAM = ABCDE12345
